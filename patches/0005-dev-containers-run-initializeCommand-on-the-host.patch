-			containerWorkspaceFolder: remoteWorkspaceFolder,
-			env: process.env,
-		}, jsonc.parse(fs.readFileSync(devcontainerPath, 'utf8'))));
+		const { devcontainerPath, remoteWorkspaceFolder, idLabels, devContainerConfig } = loadDevContainerConfig(workspaceFolder);
 
 		// Determine the Dockerfile or image
 		const devcontainerDir = path.dirname(devcontainerPath);
@@ -178,7 +286,7 @@ export class TerminalBuilder {
 		// Build the image name
 		let builtImageName: string;
 		if (dockerfilePath) {
-			builtImageName = `vsc-${folderName}-${Date.now()}`.toLowerCase();
+			builtImageName = `vsc-${path.basename(workspaceFolder)}-${Date.now()}`.toLowerCase();
 		} else if (imageName) {
 			builtImageName = imageName;
 		} else {
@@ -252,6 +360,9 @@ export class TerminalBuilder {
 
 		let scriptContent = generateScriptContent();
 
+		// Run initializeCommand on the host before building or creating anything
+		scriptContent += generateInitializeCommandScript(devContainerConfig.initializeCommand, workspaceFolder, isWindows);
+
 		// Generate build command using spec-node if we have a Dockerfile
 		if (dockerfilePath) {
 			const buildContext = devContainerConfig.build?.context ? path.join(devcontainerDir, devContainerConfig.build.context) : devcontainerDir;
