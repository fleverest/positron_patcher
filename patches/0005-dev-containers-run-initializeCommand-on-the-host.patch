 	return arg;
 }
 
+/**
+ * Finds, parses and variable-substitutes the workspace's devcontainer.json
+ */
+function loadDevContainerConfig(workspaceFolder: string) {
+	// Find the devcontainer.json file - check both standard locations
+	let devcontainerPath = path.join(workspaceFolder, '.devcontainer', 'devcontainer.json');
+	if (!fs.existsSync(devcontainerPath)) {
+		// Try .devcontainer.json in workspace root
+		devcontainerPath = path.join(workspaceFolder, '.devcontainer.json');
+		if (!fs.existsSync(devcontainerPath)) {
+			throw new Error(`Dev container configuration not found. Expected at ${path.join(workspaceFolder, '.devcontainer', 'devcontainer.json')} or ${path.join(workspaceFolder, '.devcontainer.json')}`);
+		}
+	}
+
+	// Setup folder paths
+	const folderName = path.basename(workspaceFolder);
+	const remoteWorkspaceFolder = `/workspaces/${folderName}`;
+
+	// Labels identifying this dev container; also the inputs to ${devcontainerId}
+	const idLabels = {
+		'devcontainer.local_folder': workspaceFolder,
+		'devcontainer.config_file': devcontainerPath,
+	};
+
+	// Read and parse the devcontainer.json (supports comments via JSONC), then
+	// expand ${localEnv:...}, ${localWorkspaceFolder}, ${containerWorkspaceFolder},
+	// ${devcontainerId} etc., as the dev container spec requires. ${containerEnv:...}
+	// is left for later, since it can only be resolved inside the running container.
+	const devContainerConfig = beforeContainerSubstitute(idLabels, substitute({
+		platform: process.platform,
+		configFile: URI.file(devcontainerPath),
+		localWorkspaceFolder: workspaceFolder,
+		containerWorkspaceFolder: remoteWorkspaceFolder,
+		env: process.env,
+	}, jsonc.parse(fs.readFileSync(devcontainerPath, 'utf8'))));
+
+	return { devcontainerPath, remoteWorkspaceFolder, idLabels, devContainerConfig };
+}
+
+/**
+ * Generates the script section that runs `initializeCommand` on the host, in
+ * the workspace folder, before the image is built. A failure aborts the build.
+ *
+ * String commands run through the platform shell (`sh -c` / `cmd /c`), array
+ * commands run without a shell, and object commands run each entry in turn.
+ */
+function generateInitializeCommandScript(
+	command: unknown,
+	workspaceFolder: string,
+	isWindows: boolean
+): string {
+	const commands: [string | undefined, string | string[]][] = [];
+	if (typeof command === 'string' || Array.isArray(command)) {
+		commands.push([undefined, command]);
+	} else if (command && typeof command === 'object') {
+		for (const [name, cmd] of Object.entries(command)) {
+			if (typeof cmd === 'string' || Array.isArray(cmd)) {
+				commands.push([name, cmd]);
+			}
+		}
+	}
+	if (commands.length === 0) {
+		return '';
+	}
+
+	let script = '';
+	if (isWindows) {
+		script += 'Write-Host "==> Running initializeCommand..."\n';
+		script += `Push-Location -LiteralPath ${escapePowerShellArg(workspaceFolder)}\n`;
+		script += 'try {\n';
+		for (const [name, cmd] of commands) {
+			if (name) {
+				script += `    Write-Host ${escapePowerShellArg(`Running ${name}...`)}\n`;
+			}
+			script += typeof cmd === 'string'
+				? `    & cmd.exe /c ${escapePowerShellArg(cmd)}\n`
+				: `    & ${cmd.map(escapePowerShellArg).join(' ')}\n`;
+			script += '    if ($LASTEXITCODE -ne 0) { throw "initializeCommand failed with exit code $LASTEXITCODE" }\n';
+		}
+		script += '} finally {\n';
+		script += '    Pop-Location\n';
+		script += '}\n\n';
+	} else {
+		script += 'echo "==> Running initializeCommand..."\n';
+		for (const [name, cmd] of commands) {
+			if (name) {
+				script += `echo ${escapeShellArg(`Running ${name}...`)}\n`;
+			}
+			const shellCmd = typeof cmd === 'string'
+				? `sh -c ${escapeShellArg(cmd)}`
+				: cmd.map(escapeShellArg).join(' ');
+			script += `(cd ${escapeShellArg(workspaceFolder)} && ${shellCmd})\n`;
+		}
+		script += '\n';
+	}
+	return script;
+}
+
 /**
  * Generates lifecycle hooks script to be included in the build script
  */
@@ -113,6 +212,45 @@ function generateLifecycleHooksScript(
  * Builds and runs dev containers using actual docker commands in a terminal
  */
 export class TerminalBuilder {
+	/**
+	 * Run initializeCommand on the host without building, for when an existing
+	 * container is reused. Output goes to the Dev Containers log; a non-zero
+	 * exit rejects, so the container is not started.
+	 */
+	static async runInitializeCommand(workspaceFolder: string): Promise<void> {
+		const logger = getLogger();
+		const { devContainerConfig } = loadDevContainerConfig(workspaceFolder);
+		const isWindows = os.platform() === 'win32';
+		const script = generateInitializeCommandScript(devContainerConfig.initializeCommand, workspaceFolder, isWindows);
+		if (!script) {
+			return;
+		}
+
+		const [shell, args] = isWindows
+			? ['powershell.exe', ['-NoProfile', '-NonInteractive', '-Command', `$ErrorActionPreference = "Stop"\n${script}`]]
+			: ['/bin/sh', ['-c', `set -e\n${script}`]];
+
+		await new Promise<void>((resolve, reject) => {
+			const proc = cp.spawn(shell, args, { cwd: workspaceFolder });
+			let tail = '';
+			const onData = (data: Buffer) => {
+				const text = data.toString();
+				tail = (tail + text).slice(-2000);
+				for (const line of text.split(/\r?\n/)) {
+					if (line.trim()) {
+						logger.info(`[initializeCommand] ${line}`);
+					}
+				}
+			};
+			proc.stdout.on('data', onData);
+			proc.stderr.on('data', onData);
+			proc.on('error', reject);
+			proc.on('close', code => code === 0
+				? resolve()
+				: reject(new Error(`initializeCommand failed with exit code ${code}:\n${tail.trim()}`)));
+		});
+	}
+
 	/**
 	 * Build and create a dev container in a terminal
 	 */
@@ -124,37 +262,7 @@ export class TerminalBuilder {
 		const logger = getLogger();
 		const config = Configuration.getInstance();
 
